generator client {
  provider = "prisma-client-js"
}

// Classroom default: SQLite so the app runs without a DB server.
// Production / lab: set provider = "postgresql" and DATABASE_URL to Postgres
// (see docker-compose.yml).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Verdict {
  QUEUED
  RUNNING
  AC
  WA
  TLE
  RTE
  CE
  MLE
}

enum Language {
  CPP
  PYTHON
}

model User {
  id            String                 @id @default(cuid())
  username      String                 @unique
  displayName   String
  passwordHash  String
  role          Role                   @default(STUDENT)
  sessionVersion Int                   @default(0)
  bio           String                 @default("")
  school        String                 @default("")
  avatarData    Bytes?
  avatarMimeType String?
  email         String?                @unique
  emailVerifiedAt DateTime?
  pendingEmail  String?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  nameColorMode String @default("RANK")
  nameColorAchievementId String?
  achievementNotificationsInitialized Boolean @default(false)
  gachaTickets Int @default(0)
  chessRating Int @default(1200)
  chessGamesPlayed Int @default(0)
  chessWins Int @default(0)
  chessDraws Int @default(0)
  chessLosses Int @default(0)
  featuredGachaCardId String?
  createdAt     DateTime               @default(now())
  news          News[]
  problems      Problem[]              @relation("Author")
  submissions   Submission[]
  contests      Contest[]              @relation("ContestAuthor")
  wikiArticles  WikiArticle[]          @relation("WikiAuthor")
  registrations ContestRegistration[]
  achievementUnlocks AchievementUnlock[]
  gachaCards UserGachaCard[]
  gachaPulls GachaPull[]
  gachaBannerPity UserGachaBannerPity[]
  gachaRewardClaims GachaRewardClaim[]
  battleDeck UserBattleDeck?
  chessWhiteMatches ChessMatch[] @relation("ChessWhitePlayer")
  chessBlackMatches ChessMatch[] @relation("ChessBlackPlayer")
  featuredGachaCard GachaCard? @relation("FeaturedGachaCard", fields: [featuredGachaCardId], references: [id], onDelete: SetNull)
}

model ChessMatch {
  id            String   @id @default(cuid())
  roomId        String
  whiteUserId   String
  blackUserId   String?
  timeControlId String
  status        String   @default("WAITING")
  moves         String   @default("[]")
  initialTimeMs Int      @default(300000)
  whiteTimeMs   Int      @default(0)
  blackTimeMs   Int      @default(0)
  incrementSeconds Int   @default(0)
  clockStartedAt DateTime?
  drawOfferBy   String?
  result        String?
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  whitePlayer   User     @relation("ChessWhitePlayer", fields: [whiteUserId], references: [id], onDelete: Cascade)
  blackPlayer   User?    @relation("ChessBlackPlayer", fields: [blackUserId], references: [id], onDelete: Cascade)

  @@index([roomId, status, createdAt])
  @@index([whiteUserId, createdAt])
  @@index([blackUserId, createdAt])
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

model WikiArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String   @default("")
  content     String
  sourceName  String?
  sourceUrl   String?
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation("WikiAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, published])
}

model RoadmapStage {
  id          String   @id @default(cuid())
  sortOrder   Int
  level       String
  title       String
  description String
  topics      String
  checkpoint  String
  resources   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Achievement {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  icon            String   @default("🏅")
  rarity          String   @default("COMMON")
  secret          Boolean  @default(false)
  triggerType     String
  threshold       Int      @default(1)
  problemSlug     String?
  nameColorEnabled Boolean @default(false)
  nameColor       String?
  createdAt       DateTime @default(now())

  @@index([rarity, secret])
}

model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementKey String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
}

model Problem {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  statement     String
  timeLimitMs   Int              @default(1000)
  memoryLimitMb Int              @default(256)
  difficulty    Difficulty       @default(EASY)
  published     Boolean          @default(true)
  contestOnly   Boolean          @default(false)
  judgeType     String           @default("STANDARD")
  scoringMode   String           @default("ICPC")
  heuristicTolerancePercent Int      @default(5)
  achievementBadgeTitle String?
  achievementBadgeDescription String?
  achievementScoreThreshold Int?
  ioMode        String           @default("STDIO")
  inputFile     String?
  outputFile    String?
  authorId      String
  author        User             @relation("Author", fields: [authorId], references: [id])
  createdAt     DateTime         @default(now())
  testCases     TestCase[]
  submissions   Submission[]
  contestLinks  ContestProblem[]
  tags          Tag[]            @relation("ProblemTags")
  gachaAcRewardMin Int @default(5)
  gachaAcRewardMax Int @default(10)
  gachaPacRewardMin Int @default(0)
  gachaPacRewardMax Int @default(5)
  specialGachaCardId String?
  specialGachaDropRate Float @default(0)
  specialGachaCard GachaCard? @relation("ProblemSpecialGachaCard", fields: [specialGachaCardId], references: [id], onDelete: SetNull)
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  problems Problem[] @relation("ProblemTags")
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  output    String
  isSample  Boolean @default(false)
  points    Int     @default(100)
  order     Int     @default(0)
}

model Contest {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String
  startAt       DateTime
  endAt         DateTime
  testLimit     Int                    @default(5)
  scoringMode   String                 @default("ICPC")
  rankPointsEnabled Boolean             @default(false)
  passwordHash  String?
  authorId      String
  author        User                   @relation("ContestAuthor", fields: [authorId], references: [id])
  createdAt     DateTime               @default(now())
  problems      ContestProblem[]
  registrations ContestRegistration[]
  submissions   Submission[]
  gachaAcRewardMin Int @default(5)
  gachaAcRewardMax Int @default(10)
  gachaPacRewardMin Int @default(0)
  gachaPacRewardMax Int @default(5)
  specialGachaCardId String?
  specialGachaDropRate Float @default(0)
  specialGachaCard GachaCard? @relation("ContestSpecialGachaCard", fields: [specialGachaCardId], references: [id], onDelete: SetNull)
}

model ContestProblem {
  contestId   String
  problemId   String
  letter      String
  customTitle String?
  judgeType   String?
  ioMode      String?
  inputFile   String?
  outputFile  String?
  points      Int     @default(100)
  contest     Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem     Problem @relation(fields: [problemId], references: [id])

  @@id([contestId, problemId])
}

model ContestRegistration {
  contestId String
  userId    String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@id([contestId, userId])
}

model Submission {
  id        String    @id @default(cuid())
  userId    String
  problemId String
  contestId String?
  language  Language
  source    String
  verdict   Verdict   @default(QUEUED)
  timeMs    Int?
  memoryKb  Int?
  score     Int       @default(0)
  log       String    @default("")
  createdAt DateTime  @default(now())
  judgeAttempts       Int       @default(0)
  judgeNextAttemptAt  DateTime?
  judgeStartedAt      DateTime?
  user      User      @relation(fields: [userId], references: [id])
  problem   Problem   @relation(fields: [problemId], references: [id])
  contest   Contest?  @relation(fields: [contestId], references: [id])

  @@index([verdict, judgeNextAttemptAt, createdAt])
}

model GachaBanner {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  type        String   @default("NORMAL")
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  legendaryPity Int     @default(0)
  cards       GachaBannerCard[]
  pulls       GachaPull[]
  pityProgress UserGachaBannerPity[]

  @@index([active, type, startsAt, endsAt])
}

model GachaCard {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  rarity      String   @default("COMMON")
  specialOnly Boolean  @default(false)
  category    String   @default("DISPLAY")
  battleType  String   @default("MONSTER")
  attack      Int      @default(0)
  defense     Int      @default(0)
  manaCost    Int      @default(0)
  level       Int      @default(1)
  requiredTributes Int?
  element     String   @default("Tin học")
  icon        String   @default("🃏")
  critRate    Int      @default(0)
  evasionRate Int      @default(0)
  counterRate Int      @default(0)
  lifeStealRate Int    @default(0)
  specialEffect String @default("NONE")
  bugPart     String?
  imageData   Bytes?
  imageMimeType String?
  createdAt   DateTime @default(now())
  banners     GachaBannerCard[]
  ownedBy     UserGachaCard[]
  inBattleDecks UserBattleDeckCard[]
  pulls       GachaPull[]
  rewardClaims GachaRewardClaim[]
  featuredBy  User[] @relation("FeaturedGachaCard")
  problemDrops Problem[] @relation("ProblemSpecialGachaCard")
  contestDrops Contest[] @relation("ContestSpecialGachaCard")
}

model GachaBannerCard {
  bannerId String
  cardId   String
  dropRate Float
  banner   GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  card     GachaCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([bannerId, cardId])
}

model UserGachaCard {
  userId String
  cardId String
  count  Int      @default(1)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card   GachaCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

model UserGachaBannerPity {
  userId     String
  bannerId   String
  failedPulls Int      @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner     GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@id([userId, bannerId])
}

model UserBattleDeck {
  id        String               @id @default(cuid())
  userId    String               @unique
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     UserBattleDeckCard[]
}

model UserBattleDeckCard {
  deckId String
  cardId String
  count  Int            @default(1)
  deck   UserBattleDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card   GachaCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
}

model GachaPull {
  id        String     @id @default(cuid())
  userId    String
  bannerId  String
  cardId    String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner    GachaBanner @relation(fields: [bannerId], references: [id], onDelete: Restrict)
  card      GachaCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model GachaRewardClaim {
  id             String   @id @default(cuid())
  eventKey       String   @unique
  userId         String
  problemId      String
  contestId      String?
  submissionId   String?
  rewardType     String
  ticketsAwarded Int      @default(0)
  cardId         String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           GachaCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([submissionId])
}
