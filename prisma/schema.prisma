generator client {
  provider = "prisma-client-js"
}

// Classroom default: SQLite so the app runs without a DB server.
// Production / lab: set provider = "postgresql" and DATABASE_URL to Postgres
// (see docker-compose.yml).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Verdict {
  QUEUED
  RUNNING
  AC
  WA
  TLE
  RTE
  CE
  MLE
}

enum Language {
  CPP
  PYTHON
}

model User {
  id            String                 @id @default(cuid())
  username      String                 @unique
  displayName   String
  passwordHash  String
  role          Role                   @default(STUDENT)
  sessionVersion Int                   @default(0)
  bio           String                 @default("")
  school        String                 @default("")
  avatarData    Bytes?
  avatarMimeType String?
  email         String?                @unique
  emailVerifiedAt DateTime?
  pendingEmail  String?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  nameColorMode String @default("RANK")
  nameColorAchievementId String?
  achievementNotificationsInitialized Boolean @default(false)
  createdAt     DateTime               @default(now())
  news          News[]
  problems      Problem[]              @relation("Author")
  submissions   Submission[]
  contests      Contest[]              @relation("ContestAuthor")
  wikiArticles  WikiArticle[]          @relation("WikiAuthor")
  registrations ContestRegistration[]
  achievementUnlocks AchievementUnlock[]
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

model WikiArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  summary     String   @default("")
  content     String
  sourceName  String?
  sourceUrl   String?
  published   Boolean  @default(false)
  authorId    String
  author      User     @relation("WikiAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, published])
}

model Achievement {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  icon            String   @default("🏅")
  rarity          String   @default("COMMON")
  secret          Boolean  @default(false)
  triggerType     String
  threshold       Int      @default(1)
  problemSlug     String?
  nameColorEnabled Boolean @default(false)
  nameColor       String?
  createdAt       DateTime @default(now())

  @@index([rarity, secret])
}

model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementKey String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
}

model Problem {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  statement     String
  timeLimitMs   Int              @default(1000)
  memoryLimitMb Int              @default(256)
  difficulty    Difficulty       @default(EASY)
  published     Boolean          @default(true)
  contestOnly   Boolean          @default(false)
  judgeType     String           @default("STANDARD")
  scoringMode   String           @default("ICPC")
  heuristicTolerancePercent Int      @default(5)
  achievementBadgeTitle String?
  achievementBadgeDescription String?
  achievementScoreThreshold Int?
  ioMode        String           @default("STDIO")
  inputFile     String?
  outputFile    String?
  authorId      String
  author        User             @relation("Author", fields: [authorId], references: [id])
  createdAt     DateTime         @default(now())
  testCases     TestCase[]
  submissions   Submission[]
  contestLinks  ContestProblem[]
  tags          Tag[]            @relation("ProblemTags")
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  problems Problem[] @relation("ProblemTags")
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  output    String
  isSample  Boolean @default(false)
  points    Int     @default(100)
  order     Int     @default(0)
}

model Contest {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String
  startAt       DateTime
  endAt         DateTime
  testLimit     Int                    @default(5)
  scoringMode   String                 @default("ICPC")
  rankPointsEnabled Boolean             @default(false)
  passwordHash  String?
  authorId      String
  author        User                   @relation("ContestAuthor", fields: [authorId], references: [id])
  createdAt     DateTime               @default(now())
  problems      ContestProblem[]
  registrations ContestRegistration[]
  submissions   Submission[]
}

model ContestProblem {
  contestId   String
  problemId   String
  letter      String
  customTitle String?
  judgeType   String?
  ioMode      String?
  inputFile   String?
  outputFile  String?
  points      Int     @default(100)
  contest     Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem     Problem @relation(fields: [problemId], references: [id])

  @@id([contestId, problemId])
}

model ContestRegistration {
  contestId String
  userId    String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@id([contestId, userId])
}

model Submission {
  id        String    @id @default(cuid())
  userId    String
  problemId String
  contestId String?
  language  Language
  source    String
  verdict   Verdict   @default(QUEUED)
  timeMs    Int?
  memoryKb  Int?
  score     Int       @default(0)
  log       String    @default("")
  createdAt DateTime  @default(now())
  judgeAttempts       Int       @default(0)
  judgeNextAttemptAt  DateTime?
  judgeStartedAt      DateTime?
  user      User      @relation(fields: [userId], references: [id])
  problem   Problem   @relation(fields: [problemId], references: [id])
  contest   Contest?  @relation(fields: [contestId], references: [id])

  @@index([verdict, judgeNextAttemptAt, createdAt])
}
