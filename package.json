{
  "name": "a2clttoj",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgres": "node scripts/prepare-postgres-schema.mjs && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate:deploy": "node scripts/prepare-postgres-schema.mjs && prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "build:vercel": "node scripts/check-vercel-env.mjs && npm run db:generate:postgres && npm run db:migrate:deploy && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "prisma": "6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
