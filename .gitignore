# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/chess-engine/sf_19_smallnet.js
/public/chess-engine/sf_19_smallnet.wasm
/public/chess-engine/LICENSE

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite
/prisma/*.db
/prisma/*.db-journal
/prisma/schema.postgresql.prisma
/prisma/migrations-postgresql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
