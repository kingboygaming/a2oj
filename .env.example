# SQLite (mặc định, chạy ngay trên máy)
DATABASE_URL="file:./dev.db"

# PostgreSQL local (khi dùng docker compose up -d)
# DATABASE_URL="postgresql://oj:oj@localhost:5432/tinoj?schema=public"
# DIRECT_URL="postgresql://oj:oj@localhost:5432/tinoj?schema=public"
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-dai"
# Vercel production dùng Neon PostgreSQL. Giữ DATABASE_URL là connection pooler
# và DIRECT_URL là connection trực tiếp (Neon dashboard cung cấp cả hai).
# DATABASE_URL="postgresql://...-pooler.../a2oj?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://.../a2oj?sslmode=require"
# SMTP dùng để gửi liên kết xác minh email trong tài khoản.
# APP_URL phải là URL công khai mà người dùng mở được.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="TinOJ <noreply@example.com>"
# APP_URL="http://localhost:3000"
JUDGE_MODE="mock"
# Live IDE chỉ bật khi Docker runner cô lập đã được build và Docker đang chạy.
# ENABLE_IDE_DOCKER_RUN="true"
# IDE_RUNNER_IMAGE="tinoj-ide-runner:latest"
# IDE_DOCKER_COMMAND="C:\Program Files\Docker\Docker\resources\bin\docker.exe"
# Với Vercel, dùng runner riêng qua HTTPS thay vì Docker cục bộ:
# IDE_RUNNER_URL="https://runner.example.com/run"
# IDE_RUNNER_SECRET="chuoi-ngau-nhien-it-nhat-32-ky-tu"
