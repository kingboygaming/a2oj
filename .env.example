# SQLite (mặc định, chạy ngay trên máy)
DATABASE_URL="file:./dev.db"

# PostgreSQL (khi dùng docker compose up -d)
# Đổi provider trong prisma/schema.prisma thành "postgresql"
# DATABASE_URL="postgresql://oj:oj@localhost:5432/tinoj?schema=public"

SESSION_SECRET="thay-bang-chuoi-ngau-nhien-dai"
# SMTP dùng để gửi liên kết xác minh email trong tài khoản.
# APP_URL phải là URL công khai mà người dùng mở được.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="TinOJ <noreply@example.com>"
# APP_URL="http://localhost:3000"
JUDGE_MODE="mock"
